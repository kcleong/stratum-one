# Copy to .env (gitignored) and fill in. Leave MQTT_HOST empty to disable MQTT.
# Use an IP: mDNS (.local) names don't resolve inside the container.
MQTT_HOST=192.168.22.222
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
#MQTT_INTERVAL=10
#MQTT_TOPIC_PREFIX=stratum_one
#HA_DISCOVERY_PREFIX=homeassistant
#NODE_ID=lobsang
#API_PORT=8000
#CHRONY_INTERVAL=5
#CLIENTS_INTERVAL=60           # `chronyc clients` poll; the list gets large on a public server
#HISTORY_HOURS=24             # full-resolution window kept in memory
#HISTORY_DAYS=30              # kept in SQLite; ~1.5 MiB per day
#HISTORY_FLUSH_MINUTES=15      # SQLite batch interval; a power cut loses at most this much
#HISTORY_DB=/data/history.db   # empty = memory only
#GEOIP_DIR=/data/geoip         # DB-IP Lite country/ASN for the clients table, fetched monthly; empty = off
#SKY_HOURS=24                  # sky coverage map window (signal per 10° patch, sampled every 30 s)
#POOL_SERVERS=                 # your NTP Pool addresses, comma-separated; empty = no pool score chart
#POOL_INTERVAL=900             # seconds between pool score fetches
#BURST_REQ_S=100               # NTP load that starts a traffic burst capture (clients behind it); 0 = off
